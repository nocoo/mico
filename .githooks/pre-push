#!/bin/sh
# Pre-push gate: B1 build, L3 integration and G2 dependencies for the exact OIDs
# being pushed. L4 stays in CI because the browser suite takes about three minutes.
set -eu

repo=$(git rev-parse --show-toplevel)
cd "$repo"

for tool in node osv-scanner; do
	command -v "$tool" >/dev/null 2>&1 || {
		echo "pre-push: $tool is missing; install it instead of bypassing the gate" >&2
		exit 1
	}
done

failed=0

check() {
	local_ref=$1
	local_oid=$2
	directory=$(mktemp -d "${TMPDIR:-/tmp}/mico-push-XXXXXX")
	echo "pre-push: $local_ref ($local_oid)"
	git worktree add --detach "$directory/tree" "$local_oid" >/dev/null
	ln -s "$repo/node_modules" "$directory/tree/node_modules"
	git show "$local_oid:pnpm-lock.yaml" >"$directory/pnpm-lock.yaml"

	if ! cmp -s "$directory/pnpm-lock.yaml" "$repo/node_modules/.pnpm/lock.yaml"; then
		echo "pre-push: installed dependencies do not match $local_oid; install its lockfile first" >&2
		failed=1
	elif ! (cd "$directory/tree" && node_modules/.bin/tsc --noEmit && node_modules/.bin/vite build && node scripts/run-tests.ts integration); then
		echo "pre-push: build or integration failed for $local_oid" >&2
		failed=1
	fi
	if ! osv-scanner scan --lockfile="$directory/pnpm-lock.yaml" >/dev/null; then
		echo "pre-push: dependency scan failed for $local_oid" >&2
		failed=1
	fi

	git worktree remove --force "$directory/tree" >/dev/null 2>&1 || true
	rm -rf "$directory"
}

while read -r local_ref local_oid remote_ref remote_oid; do
	case "$local_oid" in
		*[!0]*) check "$local_ref" "$local_oid" ;;
		*) echo "pre-push: skipping deletion of $remote_ref" ;;
	esac
done

exit "$failed"
