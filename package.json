{
	"name": "mico",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"daemon": "node --watch src/server/index.ts",
		"mico": "node src/cli/index.ts",
		"build": "tsc --noEmit && vite build",
		"check": "biome check . && tsc --noEmit",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"lucide-react": "1.62.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	}
}
