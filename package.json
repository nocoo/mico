{
	"name": "mico",
	"version": "0.9.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"daemon": "node --watch src/server/index.ts",
		"eval:server": "node scripts/eval-server.ts",
		"eval:capture": "node scripts/eval-capture.ts",
		"eval:live-case": "node scripts/run-live-case.ts",
		"eval:ai": "node scripts/ai-pipeline-eval.ts",
		"mico": "node src/cli/index.ts",
		"build": "tsc --noEmit && vite build",
		"check": "pnpm run lint && pnpm run typecheck",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings .",
		"test": "node scripts/run-tests.ts all",
		"test:unit": "node scripts/run-tests.ts unit",
		"test:integration": "node scripts/run-tests.ts integration",
		"test:e2e": "playwright test",
		"macos:dev": "cd apps/macos && go tool mygo dev",
		"macos:build": "cd apps/macos && go tool mygo build",
		"macos:test": "cd apps/macos && go test -v ./...",
		"hooks:install": "sh scripts/install-hooks.sh"
	},
	"dependencies": {
		"@ai-sdk/azure": "4.0.113",
		"@ai-sdk/openai-compatible": "3.0.93",
		"@ai-sdk/react": "4.0.159",
		"@azure/identity": "4.14.1",
		"@azure/msal-browser": "5.29.1",
		"@radix-ui/themes": "3.3.0",
		"ai": "7.0.155",
		"bootstrap": "5.3.9",
		"jose": "6.2.15",
		"lucide-react": "1.62.0",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"serve-static": "2.2.1",
		"ws": "^8.23.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/provider": "4.0.39",
		"@biomejs/biome": "^2.6.8",
		"@playwright/test": "1.65.1",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/serve-static": "2.2.0",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-react": "^6.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8"
	}
}
