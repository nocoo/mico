{
	"name": "mico",
	"version": "0.6.5",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"daemon": "node --env-file-if-exists=.env --watch src/server/index.ts",
		"eval:server": "node scripts/eval-server.ts",
		"eval:capture": "node scripts/eval-capture.ts",
		"eval:live-case": "node scripts/run-live-case.ts",
		"mico": "node src/cli/index.ts",
		"build": "tsc --noEmit && vite build",
		"check": "pnpm run lint && pnpm run typecheck",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings .",
		"test": "node scripts/run-tests.ts all",
		"test:unit": "node scripts/run-tests.ts unit",
		"test:integration": "node scripts/run-tests.ts integration",
		"test:e2e": "playwright test tests/browser/canvas.spec.ts tests/browser/canvases.spec.ts tests/browser/controls.spec.ts",
		"test:browser": "playwright test",
		"hooks:install": "sh scripts/install-hooks.sh"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "3.0.80",
		"@ai-sdk/react": "4.0.159",
		"@radix-ui/themes": "3.3.0",
		"ai": "7.0.155",
		"bootstrap": "5.3.8",
		"lucide-react": "1.62.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"ws": "^8.22.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/provider": "4.0.34",
		"@biomejs/biome": "^2.6.3",
		"@playwright/test": "1.64.1",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	}
}
