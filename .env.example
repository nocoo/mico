# Local runtime; set MICO_RUNTIME=deploy in the cloud process environment
MICO_RUNTIME=laptop

# Independent hosting capabilities; see docs/deployment.md
MICO_AUTH_MODE=none
MICO_AI_ENABLED=true
MICO_EPHEMERAL=false
# Public hosting: set the canonical HTTPS origin in the process environment.
# Entra: also set MICO_AUTH_TENANT_ID, MICO_AUTH_CLIENT_ID and
# MICO_AUTH_ALLOWED_OBJECT_IDS there. Keep deployment-specific IDs out of Git.

# Local Magpie gateway (optional overrides)
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_MODEL=auto/gpt-6-luna
MAGPIE_API_KEY=magpie
MAGPIE_LECTURE_REASONING=none

# Docker-only gateway override; container loopback is not the host
MICO_DOCKER_MAGPIE_BASE_URL=http://host.docker.internal:3425/v1

# Azure MAI-Transcribe-2 captions and GPT Image 2.5 Flare
AZURE_MAI_HOST=your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=your-transcription-deployment
AZURE_OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# MOSS Live realtime voice and native canvas tools
MOSS_REALTIME_URL=wss://api.mosi.cn/v1/realtime?model=moss-live-1.0
MOSS_API_KEY=
