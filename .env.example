# Local Magpie gateway (optional overrides)
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_MODEL=auto/gpt-6-luna
MAGPIE_API_KEY=magpie
MAGPIE_LECTURE_REASONING=none

# Azure MAI-Transcribe-2 streaming lecture captions
AZURE_MAI_HOST=your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=your-transcription-deployment

# MOSS Live realtime voice and native canvas tools
MOSS_API_KEY=
